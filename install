#!/usr/bin/env bash
# mrtoro installer for Linux (x86_64 / amd64 and aarch64 / arm64).
#
#   curl -fsSL https://raw.githubusercontent.com/khanhnq1611/mrtoro/remote-control/install | bash
#
# There are no prebuilt releases: this clones the repo, builds the binary for
# this machine with Bun, and puts `mrtoro` in a directory on your PATH. Run it
# again to update.
set -euo pipefail

REPO=${MRTORO_REPO:-https://github.com/khanhnq1611/mrtoro.git}
BRANCH=${MRTORO_BRANCH:-remote-control}
SRC=${MRTORO_SRC:-${XDG_DATA_HOME:-$HOME/.local/share}/mrtoro-src}
BIN_DIR=${MRTORO_BIN_DIR:-}
MODIFY_PATH=true
USER_PATH=$PATH # the private Bun is prepended later; never install next to it

usage() {
  cat <<EOF
mrtoro installer

Usage: install [options]

Options:
  -b, --branch <name>   git branch to build (default: $BRANCH)
  -d, --bin-dir <dir>   where to put the mrtoro binary (default: a writable
                        directory already on PATH, else ~/.local/bin)
  -s, --src <dir>       where to keep the source checkout (default: $SRC)
      --no-modify-path  never edit shell config files
  -h, --help            show this help

Example:
  curl -fsSL https://raw.githubusercontent.com/khanhnq1611/mrtoro/remote-control/install | bash -s -- --bin-dir ~/bin
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -b|--branch) BRANCH=${2:?--branch needs a value}; shift 2 ;;
    -d|--bin-dir) BIN_DIR=${2:?--bin-dir needs a value}; shift 2 ;;
    -s|--src) SRC=${2:?--src needs a value}; shift 2 ;;
    --no-modify-path) MODIFY_PATH=false; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown option: $1" >&2; usage >&2; exit 1 ;;
  esac
done

if [[ -t 1 ]]; then BOLD='\033[1m' DIM='\033[2m' RED='\033[31m' GREEN='\033[32m' NC='\033[0m'; else BOLD='' DIM='' RED='' GREEN='' NC=''; fi
step() { echo -e "${BOLD}==>${NC} $*"; }
info() { echo -e "    ${DIM}$*${NC}"; }
die() { echo -e "${RED}error:${NC} $*" >&2; exit 1; }

# --- platform -----------------------------------------------------------------
[[ $(uname -s) == Linux ]] || die "this installer supports Linux only (found $(uname -s))"
case $(uname -m) in
  x86_64|amd64) ARCH=x64 ;;
  aarch64|arm64) ARCH=arm64 ;;
  *) die "unsupported CPU architecture: $(uname -m) (need x86_64 or aarch64)" ;;
esac
if ldd --version 2>&1 | grep -qi musl; then
  die "musl-based systems (Alpine) are not supported; use a glibc distro such as Debian, Ubuntu or Fedora"
fi
TARGET=mrtoro-linux-$ARCH
BUILD_FLAGS=(--single --skip-install)
# Bun's default x64 build needs AVX2; older CPUs get the baseline build.
if [[ $ARCH == x64 ]] && ! grep -qw avx2 /proc/cpuinfo; then
  TARGET=mrtoro-linux-x64-baseline
  BUILD_FLAGS+=(--baseline)
fi
step "Installing mrtoro ($BRANCH) as $TARGET"

# --- requirements -------------------------------------------------------------
LOG=$(mktemp -t mrtoro-install.XXXXXX)
quiet() { "$@" >"$LOG" 2>&1 || { tail -n 30 "$LOG" >&2; return 1; }; }

missing=()
for tool in git curl unzip; do command -v "$tool" >/dev/null || missing+=("$tool"); done
if (( ${#missing[@]} )); then
  die "missing ${missing[*]}. Install with e.g.:
    sudo apt install ${missing[*]}      # Debian / Ubuntu / Raspberry Pi OS
    sudo dnf install ${missing[*]}      # Fedora"
fi

# --- source -------------------------------------------------------------------
if [[ -d $SRC/.git ]]; then
  step "Updating source in $SRC"
  git -C "$SRC" fetch --quiet --depth 1 origin "$BRANCH"
  git -C "$SRC" checkout --quiet --force -B "$BRANCH" FETCH_HEAD
else
  [[ -e $SRC ]] && die "$SRC exists and is not a git checkout; remove it or pass --src"
  step "Cloning $REPO into $SRC"
  mkdir -p "$(dirname "$SRC")"
  git clone --quiet --depth 1 --branch "$BRANCH" "$REPO" "$SRC"
fi
info "commit $(git -C "$SRC" log -1 --format='%h %s')"

# --- bun ----------------------------------------------------------------------
# Build with the exact Bun the repo pins. A different system Bun is left alone:
# the pinned one goes into a private directory, without touching shell config.
BUN_VERSION=$(sed -n 's/.*"packageManager": *"bun@\([^"]*\)".*/\1/p' "$SRC/package.json")
[[ -n $BUN_VERSION ]] || die "could not read the pinned Bun version from $SRC/package.json"
if ! command -v bun >/dev/null || [[ $(bun --version) != "$BUN_VERSION" ]]; then
  BUN_DIR=${XDG_DATA_HOME:-$HOME/.local/share}/mrtoro-bun
  if [[ ! -x $BUN_DIR/bin/bun || $("$BUN_DIR/bin/bun" --version) != "$BUN_VERSION" ]]; then
    step "Downloading Bun $BUN_VERSION"
    case $TARGET in
      *arm64) zip=bun-linux-aarch64.zip ;;
      *baseline) zip=bun-linux-x64-baseline.zip ;;
      *) zip=bun-linux-x64.zip ;;
    esac
    tmp=$(mktemp -d)
    curl -fsSL -o "$tmp/bun.zip" "https://github.com/oven-sh/bun/releases/download/bun-v$BUN_VERSION/$zip" ||
      die "could not download Bun $BUN_VERSION ($zip)"
    unzip -q -o "$tmp/bun.zip" -d "$tmp"
    mkdir -p "$BUN_DIR/bin"
    mv -f "$tmp/${zip%.zip}/bun" "$BUN_DIR/bin/bun"
    rm -rf "$tmp"
  fi
  export PATH="$BUN_DIR/bin:$PATH"
fi
info "bun $(bun --version)"

# --- build --------------------------------------------------------------------
step "Installing dependencies (first run takes a few minutes)"
# A package install script occasionally fails on a fresh download; one retry clears it.
(cd "$SRC" && bun install --frozen-lockfile >"$LOG" 2>&1) ||
  (cd "$SRC" && quiet bun install --frozen-lockfile) || die "bun install failed (full log: $LOG)"

step "Building the binary"
(cd "$SRC/packages/opencode" && quiet bun run script/build.ts "${BUILD_FLAGS[@]}") || die "build failed (full log: $LOG)"
BUILT=$SRC/packages/opencode/dist/$TARGET/bin/mrtoro
[[ -x $BUILT ]] || die "build finished but $BUILT is missing"
rm -f "$LOG"

# --- install ------------------------------------------------------------------
# Prefer a user-writable directory that is already on PATH, so nothing needs editing.
if [[ -z $BIN_DIR ]]; then
  IFS=: read -ra path_dirs <<<"$USER_PATH"
  for dir in "$HOME/.local/bin" "$HOME/bin" "${path_dirs[@]}"; do
    [[ $dir == "$HOME"/* && $dir != "${BUN_INSTALL:-$HOME/.bun}"/* && -d $dir && -w $dir ]] || continue
    [[ ":$USER_PATH:" == *":$dir:"* ]] && { BIN_DIR=$dir; break; }
  done
  BIN_DIR=${BIN_DIR:-$HOME/.local/bin}
fi
mkdir -p "$BIN_DIR"
# Copy then rename, so a running mrtoro is not overwritten in place.
cp "$BUILT" "$BIN_DIR/.mrtoro.new"
chmod 755 "$BIN_DIR/.mrtoro.new"
mv -f "$BIN_DIR/.mrtoro.new" "$BIN_DIR/mrtoro"
step "Installed $BIN_DIR/mrtoro ($("$BIN_DIR/mrtoro" --version))"

# --- PATH ---------------------------------------------------------------------
if [[ ":$USER_PATH:" != *":$BIN_DIR:"* ]]; then
  shell_name=$(basename "${SHELL:-bash}")
  case $shell_name in
    zsh) rc=${ZDOTDIR:-$HOME}/.zshrc; line="export PATH=\"$BIN_DIR:\$PATH\"" ;;
    fish) rc=${XDG_CONFIG_HOME:-$HOME/.config}/fish/config.fish; line="fish_add_path $BIN_DIR" ;;
    bash) rc=$HOME/.bashrc; line="export PATH=\"$BIN_DIR:\$PATH\"" ;;
    *) rc=$HOME/.profile; line="export PATH=\"$BIN_DIR:\$PATH\"" ;;
  esac
  if [[ $MODIFY_PATH == true ]]; then
    mkdir -p "$(dirname "$rc")"
    if ! grep -qsF "$line" "$rc"; then
      printf '\n# mrtoro\n%s\n' "$line" >>"$rc"
      step "Added $BIN_DIR to PATH in $rc"
    fi
    info "open a new terminal, or run:  $line"
  else
    info "$BIN_DIR is not on PATH; add it with:  $line"
  fi
fi

echo
echo -e "${GREEN}mrtoro is ready.${NC} Next:"
echo "  1. Add a provider in ~/.config/mrtoro/mrtoro.jsonc (see the README's Configuration section)"
echo "  2. Run: mrtoro"
echo "  Remote control: mrtoro remote-control login <relay-url>"
echo "  Update later by running this installer again."
